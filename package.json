{
  "name": "weaver",
  "version": "0.1.0",
  "description": "Automatic K-12 student section scheduling: greedy, MIP (HiGHS), and hybrid solvers over a pluggable rule system.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "demo": "tsx examples/runDemo.ts",
    "lint": "eslint src test examples",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "keywords": [
    "scheduling",
    "k-12",
    "constraint-satisfaction",
    "linear-programming",
    "mip"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "highs": "^1.15.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
